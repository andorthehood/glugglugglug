{
	"name": "glugglug",
	"sourceRoot": "src",
	"projectType": "library",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "npm run build",
				"cwd": "{projectRoot}"
			}
		},
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run dev",
				"cwd": "{projectRoot}"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run lint",
				"cwd": "{projectRoot}"
			}
		},
		"test": {
			"executor": "@nx/vitest:test",
			"outputs": ["{workspaceRoot}/coverage/glugglug"],
			"options": {
				"config": "{projectRoot}/vitest.config.ts",
				"reportsDirectory": "{workspaceRoot}/coverage/glugglug"
			}
		},
		"test:screenshot": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"options": {
				"command": "npm run test:screenshot",
				"cwd": "{projectRoot}"
			}
		},
		"test:screenshot:update": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"options": {
				"command": "npm run test:screenshot:update",
				"cwd": "{projectRoot}"
			}
		},
		"dev:test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run dev:test",
				"cwd": "{projectRoot}"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run typecheck",
				"cwd": "{projectRoot}"
			}
		}
	},
	"tags": ["type:library", "scope:graphics"]
}
