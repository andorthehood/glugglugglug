{
  "name": "glugglug",
  "version": "2.0.0",
  "private": true,
  "description": "Immediate-mode WebGL2 sprite renderer for 8f4e",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andorthehood/glugglug.git"
  },
  "author": "Andor Polgar",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andorthehood/glugglug/issues"
  },
  "homepage": "https://github.com/andorthehood/glugglug#readme",
  "dependencies": {},
  "devDependencies": {
    "vite": "7.3.5"
  }
}
